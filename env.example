# Copy to .env for local dev. On Railway set these as Variables.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-netlify-site.netlify.app
FRONTEND_URL=https://your-netlify-site.netlify.app
STORE_OWNER_EMAIL=your@email.com

# Payment methods (add cod to re-enable cash on delivery later)
ENABLED_PAYMENT_METHODS=jazzcash,easypaisa,bank_transfer

# Your bank account details (shown at checkout)
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=

# JazzCash (from merchant dashboard after approval)
JAZZCASH_MODE=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=https://your-netlify-site.netlify.app/order-tracking.html

# EasyPaisa (from merchant portal after approval)
EASYPAISA_MODE=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=https://your-netlify-site.netlify.app/order-tracking.html

# Gmail App Password for email notifications
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
STORE_OWNER_EMAIL=

# Twilio for OTP SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Cloudinary for permanent photo storage
CLOUDINARY_URL=
